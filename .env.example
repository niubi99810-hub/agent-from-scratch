# agent.py 会自动读取同目录的 .env（以 .env 为准，覆盖同名环境变量）。
# 用法：复制成 .env → 改下面两行 → python agent.py "你的任务"

# --- 阿里云百炼 / DashScope ---
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen3-max

# --- OpenAI 官方 ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini

# --- DeepSeek ---
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL=deepseek-chat

# Key 默认从环境变量 OPENAI_API_KEY 读取，也可以直接写在这里
# OPENAI_API_KEY=sk-replace-me

MAX_STEPS=8
AGENT_WORKSPACE=.